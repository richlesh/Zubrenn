  // Game Resource Unit Sizes
  // Energy 1 unit = 1 G WHr, Food 1 unit = 1k t, Goods 1 unit = 1k t, Material 1 unit = 1k t,
  // Water 1 unit = 1 G L, Wealth 1 = 1M credits where 1 credit = $10 USD.
  // Population 1 unit = 1000 people.
  // Happiness is a percent 0-100%
  // Cells are 10km across flats.  One cell of land is 86.6 km².
  // One road/monorail segment is 10 km. One river/canal segment is 5.77 km.
  // 1 turn = 1 Year
  // 1 metric ton = 1,000 × 2.20462 lb ≈ 2,204.62 lb

  // Per-UNIT definitions. Each entry has a movement "speed", an optional
  // "unitSize", a one-time "buildCost" map, and a yearly "costPerYear" map.
  // For a built military unit, "costPerYear" is upkeep paid each turn by the
  // unit's HOME colony, scaled by the unit's current strength / unitSize (a
  // full-strength unit pays one full costPerYear); shortfalls borrow from the
  // Federation and connected colonies like any other colony need.
  // Optional "station": a facility CAPABILITY tag a colony must provide (via a
  // building's `other` tag within the colony's control radius) for the unit to
  // be stationed/deployed there — "airbase" (Air Field or Airport), "airport"
  // (Airport only), "seaport" (Port). Omitted = may be stationed in any colony
  // (infantry, tank).
  // "unitSize" is the population per unit: for "population" it is the divisor for
  // per-worker consumption; for a military unit type it is that unit's MAXIMUM
  // strength (the cap a recruiting building fills a slot of this type up to,
  // e.g. infantry 1000, tank 500).
  // The "speed" key determins travel time for a moving unit
  // travel time = ceil(shortest-path movement cost / speed) turns.
  // Higher speed = faster.
  "units": {
    // EIA reports U.S. residential electricity use averaged ~4,437 kWh per person per year in 2020
    // ERS notes "the average American consumes roughly 1,885 lbs of food per year. That is nearly 1 ton of food annually per person"
    // US Material Footprint, RMC per capita, 2020-2021: ~ 24–27 t per capita yr-1 of raw material equivalent.
    //    Fossil energy materials ≈ 13–14 t/cap/yr
    //    Non-metallic minerals ≈ 4–6 t/cap/yr
    //    Biomass ≈ 5–6 t/cap/yr
    //    Metal ores ≈ 1.5–2 t/cap/yr
    // US Consumer goods footprint is typically quoted as 6–10 t/cap/yr of product weight
    // Average American uses 100 kL of water/year. Total national withdrawal intensity for all sectors.
    // US income is roughly $ 80 million per 1,000.  $10 is one credit so ¤8M credit / 1000

    // 1 population unit = 1 worker = 1000 population
    // Consumption per year per worker:
    //    energy: 4.5 kWh * 1000 people / 1 G WHr = 4.5 energy units
    //    food:   1 t * 1000 people / 1 kt = 1 food unit
    //    goods:  10 t * 1000 people / 1 kt = 10 goods units
    //    materials: 14 t * 1000 people / 1 kt = 14 materials units (used to build infrastructure and by factories)
    //    water:  100 kL * 1000 people / 1 G L = 0.1 water units
    //    wealth: $80M / $10 / 1M = ¤8 credits units
    
    // population costPerYear is per "unitSize/worker" population
    "population": { "name": "Population", "unitSize": 1000, "speed": 5,
        "buildCost": { },
        "costPerYear": { "food": 1, "goods": 10, "energy": 4.5, "water": 0.1, "wealth": 8 }
    },
    "infantry": { "name": "Infantry", "unitSize": 1000, "speed": 8,
        "buildCost": { "food": 0, "goods": 0, "energy": 0, "water": 0, "wealth": 0 },
        "costPerYear": { "food": 1, "goods": 10, "energy": 6, "water": 0.1, "wealth": 10 },
        "strength": { "attack":  1, "defense": 1, "hp": 5 },
        "prerequisite": {
          "population": 3
        }
      },
    // Tank batallion 500 service men, 50 tanks
    "tank": { "name": "Armored", "unitSize": 500, "speed": 4,
        "buildCost": { "food": 0, "goods": 0, "energy": 0, "water": 0, "wealth": 0 },
        "costPerYear": { "food": 2, "goods": 12, "energy": 2, "water": 0.1, "wealth": 2 },
        "strength": { "attack":  3, "defense": 3, "hp": 15 },
        "prerequisite": {
          "population": 8,
          "bonusType": [ "iron" ]
        }
    },
    // Fighter squadron 300 service men, 20 aircraft
    "fighter": { "name": "Fighter", "unitSize": 300, "speed": 16, "station": "airbase",
        "buildCost": { "food": 0, "goods": 0, "energy": 0, "water": 0, "wealth": 0 },
        "costPerYear": { "food": 1, "goods": 20, "energy": 1, "water": 0.1, "wealth": 1 },
        "strength": { "attack":  3, "defense": 3, "hp": 6 },
        "range": 20,
        "prerequisite": {
          "population": 12,
          "bonusType": [ "titanium", "crystal" ]
        }
    },
    // Bomber squadron 300 service men, 10 bombers
    "bomber": { "name": "Bomber", "unitSize": 300, "speed": 12, "station": "airport",
        "buildCost": { "food": 0, "goods": 0, "energy": 0, "water": 0, "wealth": 0 },
        "costPerYear": { "food": 2, "goods": 15, "energy": 2, "water": 0.1, "wealth": 2 },
        "strength": { "attack":  5, "defense": 1, "hp": 4 },
        "range": 40,
        "prerequisite": {
          "population": 12,
          "bonusType": [ "titanium", "crystal" ]
        }
    },
    // Single cruiser/destroyer 300 service men, 10 ballistic missiles
    // Escort group: cruisers/destroyers, a submarine, and a supply ship.
    "escort": { "name": "Escort", "unitSize": 1250, "speed": 4, "station": "seaport",
        "buildCost": { "food": 0, "goods": 0, "energy": 0, "water": 0, "wealth": 0 },
        "costPerYear": { "food": 1, "goods": 10, "energy": 1, "water": 0.1, "wealth": 1 },
        "strength": { "attack":  4, "defense": 7, "hp": 20 },
        "prerequisite": {
          "population": 15,
          "bonusType": [ "iron", "crystal" ]
        }
    },
    // Single carrier 6000 service men, 100 aircraft = 5 squadrons
    "carrier": { "name": "Carrier", "unitSize": 6000, "speed": 6, "station": "seaport",
        "buildCost": { "food": 0, "goods": 0, "energy": 0, "water": 0, "wealth": 0 },
        "costPerYear": { "food": 2, "goods": 15, "energy": 2, "water": 0.1, "wealth": 2 },
        "strength": { "attack":  12, "defense": 5, "hp": 25 },
        "range": 30,
        "prerequisite": {
          "population": 15,
          "bonusType": [ "iron", "titanium", "crystal" ]
        }
    }
  },

  // Buildings keyed by the LOWERCASE name (spaces preserved); each entry carries
  // a numeric "code" (the stable type id stored on building instances as
  // b.type). Each defines buildCost (+turns), costPerYear upkeep, bonus
  // (per-year production incl. growth/population), storage (summed into the
  // colony's per-resource caps), optional federationStorage, and "range"
  // (Air Field link distance, Space link distince is the entire map).
  // All build-eligibility requirements live under a single "prerequisite" object:
  //   building : list of lowercase building-name keys that must already exist in
  //              the colony (ALL required).
  //   network  : list of connection types the colony must have to ANOTHER of the
  //              owner's colonies: "land" (road or monorail), "river" (river/canal),
  //              "inland" ("land" or "river"), "sea", "air", "space", or "any" (any
  //              connection at all). Missing/empty = no network requirement.
  //   terrain  : terrain NAME keys of terrain types the building may be placed on.
  //   other    : extra per-cell placement tags (same vocabulary as
  //              terrainBonus.other): "sea" (on a shallow-sea tile), "river"
  //              (river/canal-adjacent land), "water"/"dry", elevation bands,
  //              etc. ALL listed tags must hold.
  //              The special tag "anywhere" waives the owner's zone-of-control
  //              requirement: the building may be placed on ANY explored cell
  //              that is NOT inside another player's zone of control (its cost
  //              is paid by, and it is owned by, the owner's nearest colony).
  //              "federation": the building is built and maintained by the
  //              Federation — its buildCost and yearly costPerYear are paid from
  //              the Federation pool (not a colony), and it is randomly idled
  //              when the Federation can't afford the full fleet's upkeep in any
  //              resource. An idled federation building stops functioning.
  //              "intelligence": while active, the building gathers intel on
  //              rival colonies within its "visibility" (Euclidean) range; the
  //              Rankings dialog only ranks rival colonies so covered.
  //   climate  : climate band names ("tropical"/"temperate"/"subpolar"/"polar")
  //              the cell must be in. Missing/empty = any climate.
  //   citySize : the colony population must be >= city population * poplulation unit size.
  // The Spaceport (code 14) creates an UNLIMITED-range "space" transport network:
  // any two of a player's colonies that both have a Spaceport are connected
  // regardless of distance. A building only contributes production/upkeep/storage
  // while its cell is worked.
  // Military buildings (e.g. Barracks, Army Base) field units via two keys:
  //   units        : map of unit-type -> count of unit SLOTS the building fields,
  //                  e.g. { "infantry": 1 } (Barracks) or { "infantry": 3,
  //                  "tank": 1 } (Army Base). Unit types are keys of the
  //                  top-level "units" map. Each slot holds one stationed unit.
  //   recruitRate  : map of unit-type -> colonists recruited per turn for each
  //                  of that type's slots while worked, e.g.
  //                  { "infantry": 400, "tank": 100 }. A type with no entry
  //                  (or 0) does not recruit at this building.
  // Each slot's unit caps at its unit TYPE's units[type].unitSize (per-type max
  // strength, e.g. infantry 1000, tank 500).
  // Recruitment pulls from the colony's population down to the shared
  // recruitMinColonyPopulation floor and only tops up a slot whose unit is home
  // (not in transit).
  "buildingTypes": {
    "biodome": {
      "code": 1,
      "name": "Biodome",
      "icon": "buildings/128/biodome.png",
      "symbol": "buildings/icons/dome.png",
      "startPopulation": 1,
      "buildCost": { "material": 200, "wealth": 100, "water": 2, "turns": 3 },
      "costPerYear": { },
      "bonus": { "energy": 50, "food": 5, "goods": 30, "material": 30, "water": 5, "wealth": 50, "happiness": 0.5, "population": 1 },
      "storage": { "energy": 75, "food": 10, "goods": 250, "material": 250, "water": 5, "wealth": 250, "happiness": 25, "population": 10 },
      "federationStorage": { "energy": 200, "food": 20, "goods": 200, "material": 200, "water":  5, "wealth": 200 },
      "prerequisite": {
        "terrain": ["grassland","hills","forest","jungle","desert","mountain-low","frozen","plains","wetlands"],
        "other": [ "intelligence" ]
      },
      "visibility": 16
    },
    "outpost": {
      "code": 37,
      "name": "Outpost",
      "icon": "buildings/128/outpost.png",
      "symbol": "buildings/icons/outpost.png",
      "buildCost": { "energy": 5, "material": 5, "wealth": 5, "water": 0.2, "turns": 2 },
      "costPerYear": { "energy": 2, "goods": 1, "wealth": 3, "water": 0.1 },
      "bonus": { },
      "storage": { },
      "federationStorage": { },
      "prerequisite": {
        "terrain": ["land"],
        "other": [ "outpost" ]
      }
    },
    "farm": {
      "code": 2,
      "name": "Farm",
      "icon": "buildings/128/farm.png",
      "symbol": "buildings/icons/plant.png",
      "buildCost":   { "energy": 10, "material": 20, "wealth": 10, "water": 0.25, "turns": 1 },
      "costPerYear": { "energy": 0.2, "material": 5, "wealth": 5, "water": 5 },
      "bonus":       { "food": "3x", "wealth": 15 },
      "storage": { "food": 25 },
      "prerequisite": {
        "building": ["biodome","solar panel"],
        "terrain": ["grassland","hills","forest","jungle","desert","mountain-low","plains","wetlands"]
      }
    },
    "agridome": {
