{
  // When true, after creating a new map show two debug dialogs: a terrain-type
  // breakdown and a terrain-bonus placement count. Set false to disable.
  "debug": false,

  // Food 1 = 1k t, material 1 = 1k t, water 1 = 1 G L, energy 1 = 1 G WHr
  // wealth 1 = 1M credits where 1 credit = $10 USD.
  // Cells are 10km across flats.  One cell of land is 86.6 km².
  // One road/monorail segment is 10 km. One river/canal segment is 5.77 km.
  // Happiness is a percent 0-100%

  // "terrain" restrictions can be a list of specific terrains:
  //    "sea", "grassland",  "hills", "forest", "jungle", "desert", "mountain-low",
  //    "mountain-high", "frozen", "plains", "wetlands"
  // They may also contain these groups:
  //    "flatland", "mountain", "trees"

  // "other" restrictions can be a list of
  //    "river":    River adjacent tile
  //    "sea":      Sea adjacent tile (for shallow sea)
  //    "water":    River or sea/wetland adjacent tile
  //    "land":     Land adjacent (for shoreline)
  //    "pristine": Destroyed by building
  //    "dry"       Not water adjacent
  //    (elevation bands, signed meters ASL = (elevation - seaLevel) * 10000)
  //    "deep":     Deep water      (depth below -1000 m ASL)
  //    "shallow":  Shallow water   (-1000 m <= depth <= 0 m ASL)
  //    "lowland":  Low land        (0 m <= altitude <= 2000 m ASL)

  // Climate-band dividing lines, as fractions of the polar line
  // (P = 25 + polar*45 deg). Each fraction ranges 0..0.35 (0%..35%):
  //   tropical/temperate divide  = tropicalFraction * P        (tropics below)
  //   temperate/subpolar divide = (1 - subpolarFraction) * P  (subpolar is the
  //                                 outer subpolarFraction of P, nearest pole)
  //   subpolar/polar divide     = P
  // Used by map generation and the tropical/temperate/subpolar placement tags.
  // The New Game dialog can override these per map.
  "climateBands": { "tropicalFraction": 0.35, "subpolarFraction": 0.15 },

  // Terrain GROUP selectors usable in any "terrain" list (buildingTypes and
  // terrainBonus). A group expands to its member terrains.
  "terrainGroups": {
    "flatland": ["grassland", "plains", "desert", "wetlands"],
    "trees":    ["jungle", "forest", "mountain-low"],
    "mountain": ["mountain-low", "mountain-high"]
  },

