  // Minimum hex distance required between two colonies (used when founding
  // colonies and when picking the colony that pays to remove transport).
  "minColonyDistance": 7,
  // Calendar year of turn 0; the displayed Year is startingYear + turn.
  "startingYear": 2500,
  // Happiness-to-growth conversion: each point of a colony's happiness rate adds
  // this fraction to its population growth rate (positive grows, negative
  // shrinks), capped by maxHappinessGrowthBonus.
  "happinessGrowthPerUnit": 0.001,
  // Hard cap on the happiness-derived growth-rate bonus (per turn).
  "maxHappinessGrowthBonus": 0.01,
  // Reserved happiness tuning constant (currently read for happiness clamping).
  "happinessCap": 20,
  // Cap on the per-turn happiness contribution (percentage points) from a
  // colony's food surplus/shortage: the food-balance term is clamped to
  // [-foodHappinessCap, +foodHappinessCap] before it folds into the happiness
  // rate, so an extreme surplus or deficit can't dominate morale.
  "foodHappinessCap": 5,
  // Population thresholds that expand a colony's zone-of-control radius: the
  // index of the highest threshold a colony's population meets is its ring size.
  "zoneOfControlSize": [0, 10000, 100000, 1000000],

  // Road bridges spanning a river/canal or a single sea tile (bridges are
  // road-only; monorails never need one):
  //   color      - bridge line color (HSL)
  //   buildCost  - one-time build cost (+turns)
  //   costPerYear- per-bridge yearly upkeep (drawn per resource from the
  //                Federation owned pool, same model as road/monorail/canal)
  "bridge": {
    "color": { "h": 0, "s": 0.75, "l": 0.5 },
    "buildCost": { "energy": 0.3, "material": 60, "water": 0.01, "wealth": 15, "turns": 2 },
    "costPerYear": { "energy": 0.5, "material": 0.5, "water": 0, "wealth": 1 }
  },

  // Road network settings:
  //   color         - built road segment line color (HSL)
  //   adjacentBonus - per-resource bonus a worked LAND cell gains when a road OR
  //                   monorail runs through it (stacks with riverAdjacentBonus)
  //   removeCost    - cost + turns to remove a road/monorail tile (nearest colony pays)
  //   costPerYear   - per-segment yearly upkeep, drawn per resource from the
  //                   Federation owned pool (same model as monorail/canal/bridge)
  //   decayRate     - fraction of UNFUNDED road segments destroyed per turn when short
  //   minPopulation - minimum colony population before roads may be built
  //   catastrophicFailure.rate   - per-turn probability (0..1) an aged road/monorail
  //                                segment fails catastrophically (0.0025 = 0.25%)
  //   catastrophicFailure.minAge - minimum segment age (years) to be failure-eligible
  "road": {
    "color": { "h": 30, "s": 0.5, "l": 0.35 },
    "adjacentBonus": { "energy": 0, "food": 0, "material": 0, "water": 0, "wealth": 2 },
    "removeCost": { "energy": 2, "food": 1, "turns": 2 },
    "costPerYear": { "energy": 0.5, "material": 1, "water": 0, "wealth": 0.75 },
    "decayRate": 0.01,
    "minPopulation": 3000,
    "catastrophicFailure": { "rate": 0.001, "minAge": 50 }
  },

  // Monorail network settings (parallel to `road`):
  //   color         - built monorail segment line color (HSL)
  //   adjacentBonus - per-resource bonus a worked LAND cell gains when a monorail
  //                   runs through it (stacks with riverAdjacentBonus)
  //   removeCost    - cost + turns to remove a monorail tile (nearest colony pays)
  //   costPerYear   - per-segment yearly upkeep, drawn per resource from the
  //                   Federation owned pool
  //   decayRate     - fraction of UNFUNDED monorail segments destroyed per turn when short
  //   minPopulation - minimum colony population before monorails may be built
  //   catastrophicFailure.rate/minAge - aged-segment catastrophic failure (see road)
  "monorail": {
    "color": { "h": 40, "s": 1.0, "l": 0.5 },
    "adjacentBonus": { "energy": 0, "food": 0, "material": 0, "water": 0, "wealth": 2 },
    "removeCost": { "energy": 2, "food": 1, "turns": 2 },
    "costPerYear": { "energy": 0.5, "material": 0.5, "water": 0, "wealth": 0.5 },
    "decayRate": 0.01,
    "minPopulation": 10000,
    "catastrophicFailure": { "rate": 0.001, "minAge": 50 }
  },

  // Natural river network settings:
  //   color         - river line color (HSL)
  //   adjacentBonus - per-resource bonus a worked LAND cell gains when a natural
  //                   river runs along one of its borders (edge-precise; stacks
  //                   with canal.adjacentBonus and seaAdjacentBonus)
  //   crossingCost  - extra movement cost (turns) to CROSS a river/canal border
  //                   that has no bridge (applied to colony-launch paths, and to
  //                   unit movement once combat is implemented)
  "river": {
    "color": { "h": 240, "s": 1, "l": 0.5 },
    "adjacentBonus": { "energy": 0, "food": 2, "material": 0, "water": 10, "wealth": 4 },
    "crossingCost": 2
  },

  // Canal network settings (player-dug waterways; drawn like rivers but lighter):
  //   color            - canal line color (HSL)
  //   adjacentBonus    - per-resource bonus a worked LAND cell gains when a canal
  //                      runs along one of its borders (stacks with river/sea)
  //   removeCost       - cost + turns to remove one canal segment (border)
  //   costPerYear      - per-segment yearly upkeep (Federation owned pool)
  //   minPopulation    - minimum colony population before canals may be dug
  //   terrain          - terrain NAME keys a canal may be dug through (group
  //                      names like "flatland"/"trees" also work); both cells of
  //                      a segment must qualify
  //   buildRadius      - max hex distance from a colony within which canals build
  //   vertexClickPixels   - canal-vertex click hit radius in pixels (absolute)
  //   vertexClickFraction - canal-vertex click hit radius as a fraction of cell size
  "canal": {
    "color": { "h": 240, "s": 1, "l": 0.75 },
    "adjacentBonus": { "energy": 0, "food": 2, "material": 0, "water": 10, "wealth": 4 },
    "removeCost": { "energy": 2, "food": 1, "turns": 2 },
    "costPerYear": { "energy": 0.1, "material": 0.5, "water": 1, "wealth": 0.3 },
    "minPopulation": 5000,
    "terrain": ["grassland", "hills", "forest", "jungle", "desert", "plains", "wetlands"],
    "buildRadius": 7,
    "vertexClickPixels": 7.5,
    "vertexClickFraction": 0.21
  },

  // Per-resource bonus a worked LAND cell gains when edge-adjacent to a sea tile.
  // Stacks with riverAdjacentBonus when adjacent to both.
  "seaAdjacentBonus": { "energy": 0, "food": 2, "material": 1, "water": 0, "wealth": 2 },
  // Cost + turns to tear down a building (Remove Improvement), paid by its colony.
  "removeImprovementCost": { "energy": 5, "food": 2, "turns": 2 },

  // Default Federation tax rate (happiness cost per colony that funds the
  // Federation treasury); the New Game/Federation UI can override per game.
  "federationTaxRate": 0,
  // Minimum colony population required to launch (found) a new colony.
  "foundColonyMinPopulation": 3000,
  // Colonists transferred from the host colony to a newly founded colony.
  "foundColonyPopulationTransfer": 1000,
  // Overland movement points a founding biodome travels per year (sets arrival
  // time based on terrain movement cost and river crossings).
  "biodomeMovementPerYear": 12,
  // Hit-test fraction (of cell size) treated as the border region when picking a
  // cell border vs its interior on click.
  "cellClickBorderMargin": 0.28,
  // Highest elevation tier in meters ASL; the top tier (mountain tops) is
  // impassable and cannot be settled or built on.
  "maxAltitudeMeters": 8000,
  // Highlight color for worked cells in the colony work view.
  "workedCellColor": { "h": 0, "s": 1, "l": 0.7 },
  // Color of the previewed overland path when launching a new colony.
  "launchPathColor": { "h": 120, "s": 0.7, "l": 0.45 }
}