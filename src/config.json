  // Display metadata for the seven resources (name, units, single-letter
  // abbrev, and description). Used for UI labels, tooltips, and the per-resource
  // maintenance cost formatting.
  "resourceTypes": {
    "energy": { "name": "Energy", "units": "GWHr", "abbrev": "E", "desc": "Electrical power generated by solar panels and energy deposits, measured in gigawatt-hours. It runs factories, buildings, and transport. Shortfalls force buildings to idle."},
    "food": { "name": "Food", "units":  "kt", "abbrev": "F", "desc": "Edible biomass harvested from worked tiles and farms, measured in kilotonnes. Colonists consume it each year. Surplus or deficit drives happiness and population growth."},
    "goods": { "name": "Goods", "units":  "kt", "abbrev": "G", "desc": "Manufactured consumer and commercial goods. It is spent constructing buildings, transport, new colonies and by consumers and industry."},
