  // maintenance cost formatting.
  "resourceTypes": {
    "energy": { "name": "Energy", "units": "GWHr", "abbrev": "E", "desc": "Electrical power generated by solar panels and energy deposits, measured in gigawatt-hours. It runs factories, buildings, and transport. Shortfalls force buildings to idle."},
    "food": { "name": "Food", "units":  "kt", "abbrev": "F", "desc": "Edible biomass harvested from worked tiles and farms, measured in kilotonnes. Colonists consume it each year. Surplus or deficit drives happiness and population growth."},
    "population": { "name": "Population", "units":  "k", "abbrev": "P", "desc": "Population is the lifeblood of the colony.  Population works the farms and industry to grow the civilization."},
    "happiness": { "name": "Happiness", "units":  "%", "abbrev": "H", "desc": "A colony's morale, accumulated from its food balance and certain buildings and bonuses. Positive happiness grows the population while negative happiness shrinks it."},
    "material": { "name": "Material", "units":  "kt", "abbrev": "M", "desc": "Raw and refined building stock mined and gathered from the land, measured in kilotonnes. Also includes manufactured consumer and commercial goods. It is spent constructing buildings, transport, new colonies and by consumers and industry."},
    "water": { "name": "Water", "units":  "GL", "abbrev": "W", "desc": "Fresh water drawn for colonists and industry, measured in gigalitres. It is consumed each year to sustain population and production."},
    "wealth": { "name": "Wealth", "units":  "M¤", "abbrev": "¤", "desc": "The colony's accumulated economic value in millions of credits. It pays building upkeep, construction costs and is used by consumers and industry. It is produced by trade, banks, and luxury bonuses."}
  },

