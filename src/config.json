  "unitCosts": {
    // EIA reports U.S. residential electricity use averaged ~4,437 kWh per person per year in 2020
    // ERS notes “the average American consumes roughly 1,885 lbs of food per year. That is nearly 1 ton of food annually per person”
    // 1 metric ton = 1,000 × 2.20462 lb ≈ 2,204.62 lb
    // Material footprint per capita for the United States is on the order of ~ 20–24 t per person per year in the 2010s-2020s.
    // average American uses 100 kL of water/year. The ~1,000 gal/d per capita figure is the total national withdrawal intensity for all sectors.
    // US income is roughly $ 80 million per 1,000.  $10 is one credit so ¤8M credit /1000

    // population costs are per 1000 population
    "population": { "unitSize": 1000, "food": 1, "material": 10, "energy": 5, "water": 0.2, "wealth": 8 },
    "infantry": { "unitSize": 1000, "food": 1, "material": 10, "energy": 6, "water": 0.2, "wealth": 10 },
    "tank": { "food": 2, "material": 2, "energy": 2, "water": 0.1, "wealth": 2 },
    "fighter": { "food": 1, "material": 1, "energy": 1, "water": 0.1, "wealth": 1 },
    "bomber": { "food": 2, "material": 2, "energy": 2, "water": 0.1, "wealth": 2 },
    "submarine": { "food": 1, "material": 1, "energy": 1, "water": 0.1, "wealth": 1 },
    "carrier": { "food": 2, "material": 2, "energy": 2, "water": 0.1, "wealth": 2 }
  },

