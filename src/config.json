      "name": "Agridome",
      "icon": "buildings/128/agridome.png",
      "symbol": "buildings/icons/plant.png",
      "buildCost":   { "energy": 40, "goods": 20, "material": 80, "wealth": 40, "water": 1, "turns": 5 },
      "costPerYear": { "energy": 10, "goods": 10, "material": 20, "wealth": 20, "water": 20 },
      "bonus":       { "food": "6x", "wealth": 30 },
      "storage": { "food": 100 },
      "prerequisite": {
